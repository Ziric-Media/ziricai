      "requiredCapabilities": ["dental.bookings.read"],
      "optionalCapabilities": [],
      "defaultActivationState": "on",
      "relevantSarahEmployees": ["admin", "operations"]
    },
    {
      "moduleId": "dental-client-database",
      "displayName": "Client database",
      "purpose": "Patient/client records linked to diary, till, and CRM.",
      "requiredCapabilities": ["dental.patients.read"],
      "optionalCapabilities": [],
      "defaultActivationState": "on",
      "relevantSarahEmployees": ["admin", "operations"]
    },
    {
      "moduleId": "dental-medical-aid",
      "displayName": "Medical aid worksheets",
