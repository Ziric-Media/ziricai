      "purpose": "Practice roster and HR workflows.",
      "capabilities": ["hr.roster.read"],
      "instructionBlockIds": []
    },
    "admin": {
      "purpose": "Cross-module coordination, client file reads, and portal navigation.",
      "capabilities": [
        "admin.portalNavigation",
        "knowledge.search",
        "dental.patients.read",
        "dental.bookings.read"
      ],
      "instructionBlockIds": ["dental.admin.overview"]
    }
  },
  "modules": [
    {
      "moduleId": "dental-command-centre",
      "displayName": "Dental Command Center",
