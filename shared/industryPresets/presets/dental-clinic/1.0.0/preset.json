      "requiredCapabilities": ["dental.medicalAid.read"],
      "optionalCapabilities": [],
      "defaultActivationState": "on",
      "relevantSarahEmployees": ["finance", "admin"]
    },
    {
      "moduleId": "dental-pos",
      "displayName": "Point of Sale",
      "purpose": "Practice till receipts posted to finance when configured.",
